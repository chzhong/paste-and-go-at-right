{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.4.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://chzhong.github.io/paste-and-go-at-right/",
  "minimum_chrome_version": "109",
  "permissions": [
    "clipboardRead",
    "contextMenus",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "__MSG_openSettings__",
    "default_icon": "icons/icon-32.png"
  },
  "commands": {
    "paste-and-open-right": {
      "description": "__MSG_commandOpenRight__"
    },
    "paste-and-open-split": {
      "description": "__MSG_commandOpenSplit__"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
